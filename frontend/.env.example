# Copy this to .env for local overrides, or set the same key in your
# Vercel project (Settings -> Environment Variables).
#
# Local dev doesn't need this — Vite proxies /api to localhost:8228 (see
# vite.config.ts). It's required once you deploy the frontend and backend
# to different domains (e.g. frontend on Vercel, backend on Render/Railway/Fly).
#
# For Vercel deployment, set this in your Vercel project dashboard:
#   VITE_API_URL=https://your-backend-domain.example.com/api

VITE_API_URL=https://your-backend-domain.example.com/api
