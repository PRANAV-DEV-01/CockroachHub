# Copy to .env for local dev, or set these in your host's dashboard
# (Render / Railway / Fly / etc.) for production.

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Super Admin

# Comma-separated list of frontend origins allowed to call this API.
# Must exactly match the URL your frontend is served from, scheme included,
# no trailing slash. Add every domain you actually use (Vercel preview URLs,
# your production Vercel domain, and localhost for dev).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-app.vercel.app
